# Salin menjadi .env.local (JANGAN di-commit). Tanpa awalan NEXT_PUBLIC_ agar tidak ikut ke browser.
GEMINI_API_KEY=isi_kunci_dari_google_ai_studio
GEMINI_MODEL=gemini-3.7-flash
AI_ENABLED=true
AI_DAILY_CALLS=15
AI_DAILY_ASKS=10
# Opsional: jika diisi, setiap permintaan harus menyertakan header x-owner-key bernilai sama
AI_OWNER_KEY=
